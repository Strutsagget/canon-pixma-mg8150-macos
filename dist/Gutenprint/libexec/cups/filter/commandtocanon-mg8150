#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# CUPS command filter for the PIXMA MG8150. Answers "ReportLevels" (sent by
# macOS and by `lp -o document-format=application/vnd.cups-command`) with the
# ink levels cached by the se.pija.canon-ink LaunchDaemon. Prints nothing.
CACHE=/Library/Printers/Gutenprint/var/ink-levels

if [ $# -ge 6 ]; then exec < "$6"; fi
while IFS= read -r line; do
  case "$line" in
    ReportLevels*) [ -r "$CACHE" ] && cat "$CACHE" >&2 ;;
  esac
done
exit 0

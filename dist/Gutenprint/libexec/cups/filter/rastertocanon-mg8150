#!/bin/sh
# CUPS filter for the PIXMA MG8150: runs Gutenprint and reports ink levels
# as marker-* attributes, so macOS can show Supply Levels.
#
# CUPS sandboxes filters without network access, so the levels are fetched
# by the se.pija.canon-ink LaunchDaemon and we only replay its cached output.
G=/Library/Printers/Gutenprint
CACHE=$G/var/ink-levels

[ -r "$CACHE" ] && cat "$CACHE" >&2
exec "$G/libexec/cups/filter/rastertogutenprint.5.3" "$@"
